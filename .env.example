# Frontend Environment Variables
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
API_URL=http://localhost:5001/api
SOCKET_URL=http://localhost:5001

# Backend Environment Variables
PORT=5001
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Optional - fallback to memory store if not provided)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emergency_corridor

# Supabase Auth Configuration (Optional - fallback to Demo Auth if not provided)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
